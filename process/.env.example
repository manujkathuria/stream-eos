# One instance owns one explicit partition. Set 0, 1, or 2 for local topics.
PARTITION=0
KAFKA_BROKERS=localhost:9092
INPUT_TOPIC=market.ticks.raw
OUTPUT_TOPIC=market.ticks.processed
PROGRESS_TOPIC=market.ticks.progress
CHANGELOG_TOPIC=market.ticks.dedup
START_OFFSET=earliest
BATCH_RECORDS=100
BATCH_BYTES=21600
DEDUP_MAX_IDS=1000000
MAX_BATCHES=0
BOOTSTRAP_LEGACY_DEDUP=false
RUN_TIMEOUT=0s
LOG_LEVEL=info
LOG_FORMAT=json
